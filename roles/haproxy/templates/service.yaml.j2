apiVersion: v1
kind: Service
metadata:
  name: pg-haproxy
  namespace: {{ k8s_namespace }}
  labels:
    app: pg-haproxy
    cluster: {{ cluster_name }}
    managed-by: ansible
spec:
  type: ClusterIP
  selector:
    app: pg-haproxy
  ports:
