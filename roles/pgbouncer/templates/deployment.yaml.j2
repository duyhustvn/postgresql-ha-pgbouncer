# {{ ansible_managed }}
# Generated for cluster {{ cluster_name }} - DO NOT EDIT MANUALLY
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pgbouncer
  namespace: {{ k8s_namespace }}
  labels:
    app: pgbouncer
    cluster: {{ cluster_name }}
    managed-by: ansible
spec:
  replicas: {{ pgbouncer_replicas }}
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 1
      maxSurge: 1
  selector:
    matchLabels:
      app: pgbouncer
  template:
    metadata:
      labels:
        app: pgbouncer
        cluster: {{ cluster_name }}
      annotations:
        checksum/config: "{{ pgbouncer_ini_checksum }}"
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
            - weight: 100
              podAffinityTerm:
                labelSelector:
                  matchLabels:
                    app: pgbouncer
                topologyKey: kubernetes.io/hostname
      containers:
        - name: pgbouncer
          image: "{{ pgbouncer_image }}"
          ports:
            - containerPort: {{ pgbouncer_port }}
              name: pgbouncer
          volumeMounts:
            - name: config-ini
              mountPath: /etc/pgbouncer/pgbouncer.ini
              subPath: pgbouncer.ini
            - name: userlist
              mountPath: /etc/pgbouncer/userlist.txt
              subPath: userlist.txt
          livenessProbe:
            tcpSocket:
              port: {{ pgbouncer_port }}
            periodSeconds: 10
          readinessProbe:
            tcpSocket:
              port: {{ pgbouncer_port }}
            periodSeconds: 5
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 1000m
              memory: 512Mi
      volumes:
        - name: config-ini
          configMap:
            name: pgbouncer-config
        - name: userlist
          secret:
            secretName: pgbouncer-userlist
            defaultMode: 0400
